{
  // ── Deploy configuration for nextsteppe.garden ──
  //
  // This file did not exist until the plant browser needed one route to run
  // code. Until then the whole build was configured in the Cloudflare dashboard,
  // where it could not be reviewed, diffed, or reproduced from a clean clone —
  // and the first change that touched deployment broke it, with an error
  // ("Missing entry-point to Worker script or to assets directory") that no
  // amount of reading this repository could have explained.
  //
  // `name` MUST stay `dry-gulch-site`. It is the identity of the existing
  // service; a different value here does not rename anything, it creates a
  // second Worker and leaves the live one serving the old build.
  "name": "dry-gulch-site",

  "main": "worker/index.js",
  "compatibility_date": "2024-11-01",

  "assets": {
    // Astro's build output. `npm run build` writes it, including `_headers`,
    // which is where the CSP and HSTS live.
    "directory": "./dist",

    // The Worker reaches the asset server through this binding, so a request
    // matching no route still gets the built 404 page rather than one invented
    // in worker/index.js.
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  // ── The two hostnames that would otherwise walk around Cloudflare Access ──
  //
  // The Zero Trust application protects `nextsteppe.garden/studio` and
  // `nextsteppe.garden/studio/*`. It does NOT protect a Worker reached on
  // `*.workers.dev` or on a per-version preview URL, because those are not the
  // zone. Both are off here, in the repo, because a dashboard toggle is undone
  // by the next `wrangler deploy` that disagrees with it.
  //
  // Turning them off is belt to worker/access.js's braces, not instead of them:
  // the studio's private routes verify Access's signed token on every request,
  // so even on an unprotected host they answer 403 and the Esri key stays unspent.
  // What these flags remove is a second public copy of the whole site.
  //
  // If a branch preview is ever wanted for review, protect it with its own
  // Access application rather than setting `preview_urls` back to true alone.
  "workers_dev": false,
  "preview_urls": false

  // THREE SECRETS, none of them in this file and none of them ever in it. Set
  // each one in the dashboard (Workers & Pages → dry-gulch-site → Settings →
  // Variables and Secrets, type **Secret**, not Text — `wrangler deploy` removes
  // Text variables that are not in this config) or with `npx wrangler secret
  // put <NAME>`. Secrets survive deploys from GitHub. For `wrangler dev` they
  // live in .dev.vars, which .gitignore keeps out of this public repo.
  //
  //   ARCGIS_API_KEY       the map's Esri World Imagery key: an ArcGIS Location
  //                        Platform key with the Basemaps privilege only. Read in
  //                        worker/map-tile.js and nowhere else. Without it the
  //                        map falls back to the 2019 USGS aerial. Esri is now
  //                        reached only through /studio/api/map-tile, so this key
  //                        is spent by one signed-in person rather than by every
  //                        visitor.
  //   ACCESS_TEAM_DOMAIN   `<team>.cloudflareaccess.com` — the Zero Trust team,
  //                        which is both the token's issuer and where its signing
  //                        certificates are published.
  //   ACCESS_AUD           the Access application's Audience tag, which pins a
  //                        token to THIS application rather than any other one
  //                        the same team might protect.
  //
  // Both ACCESS_* values are secrets for two plain reasons: a Secret survives a
  // deploy where a dashboard Text variable does not, and this repo is public, so
  // the team name would otherwise be published. worker/access.js refuses every
  // private request when either is missing — an unconfigured studio is a closed
  // studio.
  //
  // .dev.vars also carries STUDIO_DEV_BYPASS=1, which only works together with a
  // localhost hostname. It must NEVER be set as a Worker secret: do not run
  // `wrangler secret bulk .dev.vars`. See worker/access.js, isLocalDev().

  // NO `observability` block, deliberately. Enabling it samples request URLs
  // into Cloudflare's logs, and `/api/site-lookup?address=...` carries a
  // visitor's street address in its query string. SECURITY.md promises that
  // address is never logged; a debugging convenience switched on later would
  // quietly make that false. If request logging is ever wanted, move the
  // address to a POST body first.
}
