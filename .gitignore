node_modules/

# logs
npm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains editor folder
.idea/

# vscode editor folder
.vscode/*
!.vscode/extensions.json

# Local cache from `wrangler dev` (npm run dev:worker), which is how worker/ is
