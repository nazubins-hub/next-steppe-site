---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Xeriscape design and planning for the Vail Valley — water-wise landscapes and stormwater-informed planting at 7,400 feet.' } = Astro.props;
const year = new Date().getFullYear();

// Absolute URL for this page, for the canonical link and og:url.
//
// This is the ONLY use of Astro.url in the project, and it is not request input:
// the site is fully static, so at build time Astro.url is the path of the page being
// generated, fixed in the output. There is no request to reflect. SECURITY.md
// explains the distinction — the "no request input" claim there still holds, and its
// verification grep is scoped to the APIs that actually imply request handling.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  {/* No og:image yet — there are no images on this site at all, and the plant
      database forbids AI-generated plant imagery. Link previews are text-only
      until there is a real photograph or a designed typographic card. */}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Next Steppe" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a href="/" class="wordmark">
        <span class="wordmark-main">Next Steppe</span>
        <span class="wordmark-sub">Xeriscape Design &amp; Planning</span>
      </a>
      <nav class="site-nav">
        <a href="/plants">Plants</a>
        <a href="/blog">Journal</a>
        <a href="/about">About</a>
        <a href="/contact" class="btn primary nav-cta">Start a project</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div class="stamp">
        <span class="compass">&#8593;N</span>VAIL VALLEY, CO &middot; 39.6403&deg; N, 106.5455&deg; W &middot; ZONE 5B
      </div>
      <div class="footer-links">
        <a href="/plants">Plants</a>
        <a href="/blog">Journal</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/credits">Credits</a>
      </div>
      <p class="footer-fine">&copy; {year} Next Steppe &mdash; Xeriscape Design &amp; Planning. Site built with Astro, hosted on Cloudflare Pages.</p>
    </div>
  </footer>
</body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--sand);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.1rem;
    padding-bottom: 1.1rem;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .wordmark {
    text-decoration: none;
    color: var(--basalt);
    line-height: 1.15;
  }
  .wordmark-main {
    display: block;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
  }
  .wordmark-sub {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--basalt-soft);
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .site-nav a {
    text-decoration: none;
    color: var(--basalt);
  }
  .site-nav a:hover { color: var(--sienna); }
  .nav-cta { padding: 0.55rem 1.1rem; }
  .nav-cta:hover { color: var(--sand-light) !important; }

  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 5rem;
    padding: 2.5rem 0 3rem;
  }
  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }
  .footer-links {
    display: flex;
    gap: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .footer-links a { text-decoration: none; color: var(--basalt); }
  .footer-links a:hover { color: var(--sienna); }
  .footer-fine {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--basalt-soft);
    margin: 0;
  }

  @media (max-width: 640px) {
    .site-nav { font-size: 0.78rem; gap: 1rem; }
  }
</style>
