---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — Next Steppe" description="Start a xeriscape design and planning project in the Vail Valley.">
  <section class="wrap contact">
    <span class="eyebrow">Get in Touch</span>
    <h1>Start a project</h1>
    <p class="lead">
      Tell me a bit about the site and what you're working with &mdash; lot size, current
      water/drainage issues, and what you'd like the space to do.
    </p>

    <div class="grid-2 contact-grid">
      <div class="form-col">
        <!-- Outcome messages land here. role/aria-live so the result is announced,
             not only seen — the form is replaced on success, which is a large
             context change for a screen reader user. -->
        <div class="form-status" id="form-status" role="status" aria-live="polite"></div>

        <!--
          action + method are kept deliberately. The script below intercepts submit
          and posts by fetch, but with JavaScript disabled the browser posts natively
          and the enquiry still arrives. That is why the CSP carries BOTH
          form-action and connect-src for formspree.io.
        -->
        <form
          class="contact-form"
          id="contact-form"
          action="https://formspree.io/f/mlgqrnzy"
          method="POST"
        >
          <label>
            Name
            <input type="text" name="name" required />
          </label>
          <label>
            Email
            <input type="email" name="email" required />
          </label>
          <label>
            Location / property
            <input type="text" name="location" placeholder="e.g. Avon, Edwards, Eagle-Vail" />
          </label>
          <label>
            Project details
            <textarea name="message" rows="6" required placeholder="Lot size, current drainage issues, what you'd like the space to do..."></textarea>
          </label>

          <!-- Honeypot: hidden from people, irresistible to naive bots. Formspree
               discards any submission where _gotcha is filled. aria-hidden and
               tabindex keep it out of the keyboard and screen-reader path. -->
          <div class="gotcha" aria-hidden="true">
            <label>
              Leave this field empty
              <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <input type="hidden" name="_subject" value="Next Steppe enquiry" />

          <button type="submit" class="btn primary">Send</button>

          <p class="form-privacy">
            Submissions are handled by <a href="https://formspree.io/legal/privacy-policy" rel="noopener">Formspree</a>,
            a third-party form service, and emailed on to me. Nothing is stored on this site.
          </p>
          <p class="form-privacy">
            Traced your beds on the <a href="/plants/">plant browser&rsquo;s map</a>? This form
            takes text only. Say so here and keep the GeoJSON download &mdash; I&rsquo;ll reply
            with where to email it. The file carries your outlines and nothing else.
          </p>
        </form>
      </div>

      <div class="stamp contact-stamp">
        <span class="compass">&#8593;N</span>
        SERVICE AREA<br />
        Vail &middot; Avon &middot; Edwards &middot; Eagle-Vail &middot; Beaver Creek<br /><br />
        RESPONSE TIME<br />
        1&ndash;2 business days
      </div>
    </div>
  </section>
</BaseLayout>

{/*
  Not `is:inline`: Astro compiles this into a module under /_astro/, which the CSP
  already allows via script-src 'self'. Left inline it would need a fresh SHA-256 in
  the header on every build instead.
*/}
<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  if (form && status) {
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalLabel = button.textContent;

    // Two shapes deliberately, because they carry different things.
    //
    // `show` takes a trusted static literal and may contain markup. `showText`
    // takes a string that came back from Formspree — third-party data — and
    // goes in as text, never as HTML. The error branch used to interpolate that
    // response into innerHTML, which made SECURITY.md's claim that this site
    // "renders no user input" false. The CSP would have stopped a script from
    // running, but a CSP is the second line, not a reason to hand markup to a
    // parser you did not write.
    const show = (kind: 'success' | 'error', html: string) => {
      status.className = `form-status is-${kind}`;
      status.innerHTML = html;
    };

    const showText = (kind: 'success' | 'error', text: string) => {
      status.className = `form-status is-${kind}`;
      status.textContent = text;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      button.disabled = true;
      button.textContent = 'Sending…';
      status.className = 'form-status';
      status.textContent = '';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          // Without this Formspree answers with a redirect to its own page rather
          // than JSON, and the fetch silently succeeds while the user sees nothing.
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          form.hidden = true;
          show(
            'success',
            '<strong>Thanks — that came through.</strong> I read every enquiry myself and will reply within 1–2 business days.',
          );
          return;
        }

        // Formspree reports validation problems as { errors: [{ message }] }.
        const data = await response.json().catch(() => null);
        const detail = data?.errors?.map((e: { message: string }) => e.message).join('. ');
        if (detail) {
          showText('error', `Couldn’t send that: ${detail}`);
        } else {
          show('error', 'Couldn’t send that just now. Please try again, or email me directly.');
        }
      } catch {
        // Network failure, offline, or the request was blocked. Never swallow this —
        // give them a route that does not depend on the form working.
        show(
          'error',
          'Couldn’t reach the form service — you may be offline. Please try again, or send the details by email.',
        );
      } finally {
        if (!form.hidden) {
          button.disabled = false;
          button.textContent = originalLabel;
        }
      }
    });
  }
</script>

<style>
  .contact { padding-top: 3rem; padding-bottom: 4rem; }
  .lead { max-width: 600px; color: var(--basalt-soft); font-size: 1.05rem; }
  .contact-grid { margin-top: 2.5rem; align-items: start; }
  .contact-form { display: flex; flex-direction: column; gap: 1.2rem; }
  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--basalt-soft);
  }
  .contact-form input,
  .contact-form textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--sand-light);
    color: var(--basalt);
    resize: vertical;
  }
  .contact-form button { align-self: flex-start; border: none; cursor: pointer; }
  .contact-form button:disabled { opacity: 0.55; cursor: progress; }
  .contact-stamp { align-self: start; line-height: 1.9; }

  /* Honeypot. Not display:none — some bots skip fields that are outright hidden,
     and Formspree's own guidance is to keep it in the layout but out of sight. */
  .gotcha {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Hidden until the handler adds is-success/is-error. Keyed on the class rather
     than :empty, which silently breaks if the element ever gains stray whitespace
     and would leave an empty bordered box on the page. */
  .form-status { display: none; }
  .form-status.is-success,
  .form-status.is-error {
    display: block;
    border: 1px solid var(--line);
    border-left: 3px solid var(--juniper);
    border-radius: var(--radius);
    background: var(--sand-light);
    padding: 1rem 1.2rem;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .form-status.is-error { border-left-color: var(--sienna); }
  .form-status :global(strong) { display: block; margin-bottom: 0.2em; }

  .form-privacy {
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--basalt-soft);
    margin: 0.2rem 0 0;
  }
  .form-privacy a { color: inherit; }
</style>
